# Google AI / Gemini - Name of the secret in Google Secret Manager
GEMINI_API_KEY_SECRET_NAME="GEMINI_API_KEY"

# Google Cloud Storage
GCS_BUCKET_NAME="YOUR_GCS_BUCKET_NAME"
GCS_PROJECT_ID="YOUR_GCP_PROJECT_ID"

# Secret Manager secret names. Direct *_API_KEY / SUPABASE_* env values also work locally.
GEMINI_API_KEY_SECRET_NAME="gemini_api"
OPENAI_API_KEY_SECRET_NAME="openai_api_key"
SUPABASE_URL_SECRET_NAME="supabase_url"
SUPABASE_SERVICE_ROLE_KEY_SECRET_NAME="supabase_service_role_key"

# Optional local-only direct values. Private values are preferred for server-side access.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVER_ONLY_SERVICE_ROLE_KEY"

# Local development fallback if you only have the publishable browser key.
PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLIC_PUBLISHABLE_KEY"

OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# App Settings
ADMIN_PASSWORD="YOUR_SECRET_PASSWORD"
