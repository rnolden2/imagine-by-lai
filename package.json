{
	"name": "imagine-by-lai",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=22.17 <23"
	},
	"scripts": {
		"cloud": "node scripts/with-google-cloud.mjs gcloud",
		"deploy": "node scripts/with-google-cloud.mjs gcloud builds submit --config cloudbuild.yaml .",
		"kitchen:infrastructure": "node scripts/with-google-cloud.mjs node scripts/word-kitchen/setup-infrastructure.mjs",
		"monitoring:infrastructure": "node --experimental-strip-types scripts/setup-monitoring.mjs",
		"dev": "vite dev",
		"prebuild": "svelte-kit sync",
		"build": "vite build",
		"check:bundle": "node scripts/check-production-bundle.mjs",
		"preview": "vite preview",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"verify:isolated": "node scripts/verify-isolated.mjs",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "npm run test:e2e:math && npm run test:e2e:kitchen && npm run test:e2e:science && npm run test:e2e:origin && npm run test:e2e:flags",
		"test:e2e:flags": "npm run build && playwright test --config playwright.flags.config.ts",
		"test:e2e:origin": "playwright test --config playwright.origin.config.ts",
		"test:e2e:math": "playwright test --config playwright.math.config.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test:e2e:kitchen": "playwright test --config playwright.kitchen.config.ts",
		"test:db:kitchen": "node scripts/word-kitchen/test-db.mjs",
		"test:db:stories": "node scripts/verify-isolated.mjs --database",
		"kitchen:assets": "node scripts/word-kitchen/seed.mjs --prepare-assets",
		"kitchen:seed": "node scripts/word-kitchen/seed.mjs --database",
		"science:catalog": "node --experimental-strip-types scripts/science/catalog.mjs",
		"test:science": "node --experimental-strip-types --test scripts/science/catalog.test.mjs",
		"test:e2e:science": "playwright test --config playwright.science.config.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@electric-sql/pglite": "0.5.8",
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.36.0",
		"@playwright/test": "^1.55.1",
		"@sveltejs/adapter-node": "6.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "^22",
		"@types/sanitize-html": "2.16.2",
		"@vitest/browser-playwright": "5.0.5",
		"eslint": "^9.36.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.4",
		"globals": "^16.4.0",
		"playwright": "^1.55.1",
		"prettier": "3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"supabase": "2.118.0",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0",
		"vite": "8.3.5",
		"vitest": "5.0.5",
		"vitest-browser-svelte": "3.1.0"
	},
	"dependencies": {
		"@google-cloud/secret-manager": "^6.1.1",
		"@google-cloud/storage": "8.4.0",
		"@google-cloud/tasks": "7.2.1",
		"@google-cloud/text-to-speech": "^6.4.0",
		"@google/genai": "2.31.0",
		"@supabase/supabase-js": "2.110.2",
		"google-auth-library": "11.1.0",
		"marked": "^16.4.1",
		"openai": "^6.46.0",
		"postgres": "3.4.9",
		"sanitize-html": "2.18.1",
		"sharp": "0.35.5",
		"zod": "4.6.7"
	}
}
